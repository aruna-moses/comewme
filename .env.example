# Copy this file to .env and fill in real values.
# Never commit .env.

# Public — safe to expose to the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the app is reachable from (used for share links / SEO)
VITE_APP_URL=https://comewme.vercel.app

# Firebase web app config — needed for off-app push notifications (FCM).
# All public / client-safe. Grab from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Web Push certificate (VAPID key) from Firebase console:
#   Project settings → Cloud Messaging → Web Push certificates → Generate a certificate
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Optional — pin production to a Sentry release (deploy commit) so stack traces
# resolve to the exact code that failed. Example: git rev-parse --short HEAD
VITE_SENTRY_RELEASE=

# Production error monitoring via Sentry (optional).
# Get a free DSN at https://sentry.io/signup/ → Create Project → Copy DSN
# Leave blank to skip monitoring (app behaves exactly as before).
VITE_SENTRY_DSN=

# Server only — used by scripts/seed.mjs. NEVER prefix with VITE_ and never
# put this in client code. Bypasses every security policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
